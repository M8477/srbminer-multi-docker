BTC_ADDRESS=
WORKER_NAME=

# Mining algorithm: randomx (CPU), heavyhash (GPU), or heavyhash;randomx (dual)
# Default is heavyhash;randomx for GPU+CPU dual mining
ALGO=heavyhash;randomx

# Set --disable-gpu for CPU-only mining, e.g. EXTRAS=--disable-gpu --api-enable --api-port 21550 --extended-log
EXTRAS=--api-enable --api-port 21550 --extended-log

# Use IP if mDNS fails (http://192.168.x.x:8123)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
BATTERY_ENTITY=sensor.my_home_percentage_charged
SOLAR_ENTITY=sensor.my_home_solar_power
BATTERY_MIN=90
SOLAR_MIN=800
CHECK_SECS=120

# Set FORCE_MINE=Y to mine regardless of solar/battery for FORCE_MINE_MINS
FORCE_MINE=
FORCE_MINE_MINS=30
HEARTBEAT_SECS=60
API_PORT=21550

KRAKEN_KEY=
KRAKEN_SECRET=
MIN_BTC_SELL=0.0005

LOG_LEVEL=info
VERSION_TAG=3.2.8
