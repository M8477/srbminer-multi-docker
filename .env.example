BTC_ADDRESS=
WORKER_NAME=

# Mining algorithm: randomx (CPU), autolykos2 (GPU), or autolykos2;randomx (dual)
# Default is autolykos2;randomx for GPU+CPU dual mining
ALGO=autolykos2;randomx

# GPU pool (autolykos2 → Ergo on Unmineable)
POOL_ADDRESS=stratum+tcp://autolykos.unmineable.com:3333
# CPU pool (randomx → BTC on Unmineable) — only used in dual mining mode
POOL_ADDRESS_CPU=stratum+tcp://rx.unmineable.com:3333

# Set --disable-gpu for CPU-only mining, e.g. EXTRAS=--disable-gpu --api-enable --api-port 21550 --extended-log
EXTRAS=--api-enable --api-port 21550 --extended-log

# Use IP if mDNS fails (http://192.168.x.x:8123)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
BATTERY_ENTITY=sensor.my_home_percentage_charged
SOLAR_ENTITY=sensor.my_home_solar_power
BATTERY_MIN=90
SOLAR_MIN=800
CHECK_SECS=120

# Set FORCE_MINE=Y to force mining. FORCE_MINE_MINS=0 means mine forever, >0 means minutes.
FORCE_MINE=
FORCE_MINE_MINS=0
HEARTBEAT_SECS=60
API_PORT=21550

KRAKEN_KEY=
KRAKEN_SECRET=
MIN_BTC_SELL=0.0005

LOG_LEVEL=info
VERSION_TAG=3.2.8
